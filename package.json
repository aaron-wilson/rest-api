{
  "name": "rest-api",
  "version": "1.0.0",
  "description": "TypeScript-first REST API built with Bun and Hono",
  "type": "module",
  "main": "src/bootstrap.ts",
  "scripts": {
    "build": "bun build src/bootstrap.ts --outdir dist --target bun",
    "dev": "bun run --hot src/bootstrap.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "bun run dist/bootstrap.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run tests/foundation.test.ts",
    "seed": "bun run scripts/seed.ts",
    "seed:once": "bun run scripts/seed-once.ts",
    "dynamo:init": "bun run scripts/init-dynamo.ts",
    "test:dynamo": "RUN_DYNAMO_CONTRACT=1 vitest run tests/dynamo-contract.test.ts",
    "spec:snapshot": "bun run scripts/openapi-snapshot.ts",
    "infra:synth": "TSX_TSCONFIG_PATH=infra/tsconfig.json node --import ../graph-rest-react-stack/platform-cdk/node_modules/tsx/dist/loader.mjs infra/app.ts",
    "infra:typecheck": "../graph-rest-react-stack/platform-cdk/node_modules/.bin/tsc --project infra/tsconfig.json",
    "infra:test": "../graph-rest-react-stack/platform-cdk/node_modules/.bin/vitest run --config infra/vitest.config.ts"
  },
  "keywords": [
    "bun",
    "hono",
    "typescript",
    "rest-api",
    "aws"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@hono/node-server": "^2.1.3",
    "@types/bun": "^1.0.0",
    "@types/supertest": "^7.2.1",
    "commitlint": "^19.8.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "supertest": "^7.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1142.0",
    "@aws-sdk/lib-dynamodb": "^3.1142.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.203.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.203.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/sdk-logs": "0.203.0",
    "@opentelemetry/sdk-metrics": "2.0.1",
    "@opentelemetry/sdk-node": "0.203.0",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.0.0",
    "swagger-ui-dist": "^5.33.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
