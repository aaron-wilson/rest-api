# HTTP listen port; default 3000.
PORT=3000
# Minimum structured log level; default info.
LOG_LEVEL=info
# Browser origin allowed by CORS; default http://localhost:3001.
CORS_ORIGIN=http://localhost:3001
# Store adapter: memory (default) or dynamo.
PROVIDER_STORE=memory
# DynamoDB table; required when PROVIDER_STORE=dynamo.
DYNAMO_TABLE=
# AWS region used by DynamoDB; default us-east-1.
AWS_REGION=us-east-1
# Optional local-only DynamoDB endpoint; blank uses AWS SDK credential chain.
DYNAMO_ENDPOINT=
